# HTCondor submit file for TiDAR training on CHTC GPU Lab
# Based on successful MNIST example configuration

# Executable and arguments
executable = run_train.sh
arguments =

# File transfer
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = train_tidar.py, model/tidar_model.py, /home/nandwani2/segformer.sif

# Container
+SingularityImage = "segformer.sif"

# GPU Lab requirements (from CHTC GPU documentation)
+WantGPULab = true
+GPUJobLength = "medium"

# Resource requests
request_gpus = 1
gpus_minimum_memory = 40000
request_cpus = 8
request_memory = 64GB
request_disk = 50GB

# Require A100 GPU (CUDA capability 8.0)
require_gpus = (DriverVersion >= 11.0) && (Capability >= 8.0)

# Environment variables
environment = "WANDB_API_KEY=$(WANDB_API_KEY) WANDB_PROJECT=tidar-chtc"

# Output files
log = logs/tidar_$(Cluster)_$(Process).log
output = logs/tidar_$(Cluster)_$(Process).out
error = logs/tidar_$(Cluster)_$(Process).err

# Submit
queue 1
