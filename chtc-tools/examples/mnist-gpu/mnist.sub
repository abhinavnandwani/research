# HTCondor Submit File for MNIST GPU Training
# Using segformer container (has PyTorch + CUDA tools)

# Executable
executable = run_mnist.sh
arguments = --batch-size 256 --epochs 2 --lr 0.001

# Transfer files (including container from home)
transfer_input_files = train_mnist.py, /home/nandwani2/segformer.sif

# Output files
log = logs/mnist_$(Cluster)_$(Process).log
error = logs/mnist_$(Cluster)_$(Process).err
output = logs/mnist_$(Cluster)_$(Process).out

# Use the transferred container
+SingularityImage = "segformer.sif"

# Environment variables for WandB
environment = "WANDB_API_KEY=$(WANDB_API_KEY) WANDB_PROJECT=chtc-mnist"

# GPU Lab opt-in
+WantGPULab = true
+GPUJobLength = "short"

# GPU Requirements - 8GB VRAM minimum
request_gpus = 1
gpus_minimum_memory = 8000

# Resource requests
request_cpus = 4
request_memory = 16GB
request_disk = 25GB

# Queue the job
queue 1
